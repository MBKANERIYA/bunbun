{
  "outputDirectory": "FrontEnd/dist",
  "rewrites": [
    {
      "source": "/(v1/.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(images/.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(health)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
