{
  "outputDirectory": "FrontEnd/dist",
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/v1/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api/images/$1"
    },
    {
      "source": "/((?!api/|v1/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
